    String loanType;
    double loanAmount;

    public Loan(String loanNumber, String loanType, double loanAmount) {
        this.loanNumber = loanNumber;
        this.loanType = loanType;
        this.loanAmount = loanAmount;
    }

    public void displayLoanDetails() {
